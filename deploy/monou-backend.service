[Unit]
Description=Monou Landing Backend (Flask + gunicorn)
Documentation=https://github.com/rladron-rodia/landing_contacto
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=monou
Group=monou
WorkingDirectory=/opt/monou-backend
ExecStart=/opt/monou-backend/deploy/start-monou.sh
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=monou-backend

# Resource limits
LimitNOFILE=65536

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
